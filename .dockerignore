# ==========================================
# 1. Ignore Local Build Outputs & Node Modules
# ==========================================
**/node_modules/
**/dist/
**/build/

# ==========================================
# 2. Exclude Root Level Folders (Monorepo Isolation)
# ==========================================
# ❌ COMPLETELY IGNORE THESE ROOT FOLDERS
extension/
frontend/

# ==========================================
# 3. Ignore Secrets & System Files
# ==========================================
.env*
*.env
**/.env*
.git/
.github/
.DS_Store
