{
  "manifest_version": 3,
  "name": "Socratic AI Video Questioner",
  "description": "This extension allows users to ask questions about YouTube videos using Socratic AI.",
  "version": "1.0",
  "icons": {
    "16": "./icons/icon-16.png",
    "32": "./icons/icon-32.png",
    "48": "./icons/icon-48.png",
    "128": "./icons/icon-128.png"
  },
  "action": {
    "default_icon": {
        "16": "./icons/icon-16.png",
        "24": "./icons/icon-24.png",
        "32": "./icons/icon-32.png"
    }
  },
  "service-worker": {
    "src": "./dist/background-script.js"
  },
  "content_scripts": [
    {
      "js": [
        "./dist/content-script.js"
      ],
      "matches": [
        "https://*.youtube.com/watch?*"
      ]
    }
  ]
}